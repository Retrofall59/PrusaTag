<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PrusaTag"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
            <!-- L'appli officielle Prusa declare tres probablement ce meme filtre NDEF+MIME sur ses
                 propres tags, ce qui la rend prioritaire sur notre TECH_DISCOVERED seul (signale par
                 jcjames_13009 sur le forum : l'appli Prusa s'ouvrait systematiquement a la place de
                 PrusaTag). En declarant le meme filtre, Android proposera un choix au scan plutot que
                 d'imposer une appli. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openprinttag" />
            </intent-filter>
            <!-- Insuffisant seul (v1.2) : le tag contient DEUX enregistrements NDEF, le lien
                 https://3dtag.org/s/... D'ABORD, puis les donnees OpenPrintTag ensuite. Android
                 resout le dispatch sur le PREMIER enregistrement qu'une appli sait gerer : l'appli
                 Prusa officielle repond au lien et gagne avant meme qu'Android regarde le second
                 enregistrement (confirme par jcjames_13009 : une fois l'appli Prusa desinstallee,
                 c'est le navigateur qui s'ouvre sur ce lien, jamais PrusaTag). On fait maintenant
                 aussi concurrence sur le lien lui-meme, pour etre en lice des le premier
                 enregistrement et obtenir le choix entre applis plutot qu'un dispatch silencieux. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="https" android:host="3dtag.org" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

    </application>

</manifest>
